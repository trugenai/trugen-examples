# --- LiveKit Cloud (cloud.livekit.io -> Project Settings -> API Keys) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- TruGen AI (https://app.trugen.ai -> Developers -> API keys) ---
TRUGEN_API_KEY=your-trugen-api-key
# Optional: pick a stock avatar from https://docs.trugen.ai/docs/avatars/gallery
TRUGEN_AVATAR_ID=7d881c1b

# --- Hawkeye-1 focus monitoring (POST /v2/vision, billed 1c/min, enterprise) ---
HAWKEYE_MAX_DURATION=30
HAWKEYE_LOOKAWAY_THRESHOLD=3
HAWKEYE_WINDOW_SECONDS=60
HAWKEYE_COOLDOWN_SECONDS=45
# HAWKEYE_WARNING_MESSAGE=I noticed you have been looking away from the camera. Please stay focused on our conversation.